;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Maestrotto p3 32x"
run/main_scene="uid://fu36mcowqf1u"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GridManager="*uid://dj6n8kb5whsho"
InputManager="*uid://bx74khh84oefn"
TimeGlobal="*uid://ms1fkqo1v7rs"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/narrowing_conversion=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/project-time-tracker/plugin.cfg", "res://addons/project_statistics/plugin.cfg")

